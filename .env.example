# Telegram API credentials — https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The session string is stored in ~/.telegram-mcp/session by `npm run login`.
# Set it here instead if you prefer keeping everything in one place.
# TELEGRAM_SESSION=

# Optional
# TELEGRAM_MCP_READ_ONLY=1              # register read tools only
# TELEGRAM_MCP_TZ=Europe/Amsterdam      # timezone for rendered timestamps
# TELEGRAM_MCP_DOWNLOAD_DIR=~/Downloads # where download_media writes files
# TELEGRAM_MCP_DIALOG_LIMIT=400         # how many dialogs to cache for name lookup
# TELEGRAM_MCP_MAX_MESSAGES=3000        # hard ceiling per read call
